---
// Hero.astro
---
<section class="hero" id="home">
	<div class="container">
		<div class="hero-content">
			<div class="hero-text">
				<h1>Transform Your Business with Intelligent Automation</h1>
				<p>
					Dummy Website helps enterprises leverage AI, automation, and digital
					transformation to drive efficiency, enhance customer experience, and unlock
					new revenue streams.
				</p>
				<div class="hero-buttons">
					<a href="#contact" class="btn btn-primary">Get Free Consultation</a>
					<a href="#services" class="btn btn-outline">Explore Services</a>
				</div>
			</div>
			<div class="hero-image">
				<img src="/assets/images/bck.png" alt="AI Consulting Dashboard" />
			</div>
		</div>
	</div>
</section>
